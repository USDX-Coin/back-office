# Base URL for the USDX backend API (sot/project-overview.md § Infrastructure).
# Leave empty to fall back to same-origin (vite.config.ts proxy in dev,
# public/_redirects rewrite in production).
VITE_API_URL=https://backend-dev-c526.up.railway.app

# ─── Safe Wallet UI deep-link config (USDX-38) ─────────────────────────────
# These mirror the BE env (POLYGON_STAFF_SAFE_ADDRESS / POLYGON_MANAGER_SAFE_ADDRESS,
# see USDX-57). Kept in FE because sot/openapi.yaml does not yet return
# `safeAddress` on mint/burn/requests responses; tracked as Decision-B in the
# USDX-38 PR description. Keep these in sync with the BE env at all times —
# drift produces broken Safe UI deep-links.
#
# Polygon mainnet (chainId 137) is the default target per USDX-57.
VITE_SAFE_CHAIN_ID=137
VITE_POLYGON_STAFF_SAFE_ADDRESS=0xaA3e70397F3668D6Fd9C25e36a6FB151241EE015
# Manager Safe placeholder (= Staff Safe) until the actual Manager Safe is
# deployed on Polygon mainnet. Mirror the BE Railway env when it changes.
VITE_POLYGON_MANAGER_SAFE_ADDRESS=0xaA3e70397F3668D6Fd9C25e36a6FB151241EE015
