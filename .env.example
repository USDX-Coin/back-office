# Base URL for the USDX backend API (sot/project-overview.md § Infrastructure).
# Leave empty to fall back to same-origin (vite.config.ts proxy in dev,
# public/_redirects rewrite in production).
VITE_API_URL=https://api-dev.usdx.co.id

# USDX-275 — Multisig page wallet connect (wagmi/RainbowKit). WalletConnect Cloud
# project id for real wallet-connect; without a real id only injected wallets
# (MetaMask) work (the demo fallback keeps that path usable in dev). Optional
# dedicated Polygon RPC for on-chain reads + simulate (empty → wagmi public RPC).
VITE_WALLETCONNECT_PROJECT_ID=
VITE_POLYGON_RPC_URL=
