# masing-masing (api.usdx.co.id utk prod), jadi tidak mengandalkan rewrite ini.
/api/*                 https://api-dev.usdx.co.id/api/:splat  200
/mockServiceWorker.js  /mockServiceWorker.js  200
/*                     /index.html            200
